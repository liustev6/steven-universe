# Spike only: the community package with CUDA graphs, as a reference measurement.
FROM pytorch/pytorch:2.15.0-cuda13.2-cudnn9-runtime
# The image installs PyTorch with pip into /usr/local (pip's area, not apt's): add ours beside it.
ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN python -c "import torch; print(f'torch=={torch.__version__}')" > /tmp/keep-torch.txt \
 && pip install --no-cache-dir -c /tmp/keep-torch.txt faster-qwen3-tts==0.5.4 "transformers==5.15.1" soundfile \
 && python -c "import torch, transformers, faster_qwen3_tts; print('torch', torch.__version__, 'transformers', transformers.__version__)"
