# Spike only: Qwen's official package on PyTorch 2.15 (CUDA 13.2). torch is kept as the image ships it.
FROM pytorch/pytorch:2.15.0-cuda13.2-cudnn9-runtime
# The image installs PyTorch with pip into /usr/local (pip's area, not apt's): add ours beside it.
ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN python -c "import torch; print(f'torch=={torch.__version__}')" > /tmp/keep-torch.txt \
 && pip install --no-cache-dir -c /tmp/keep-torch.txt qwen-tts soundfile huggingface_hub \
 && python -c "import torch, transformers, qwen_tts; print('torch', torch.__version__, 'transformers', transformers.__version__)"
