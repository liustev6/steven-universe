[Unit]
Description=auth-service (internal OAuth 2.0 token issuer)
After=network-online.target
Wants=network-online.target

[Service]
User=authsvc
Group=authsvc
WorkingDirectory=/opt/auth-service
Environment=AUTH_SERVICE_CONFIG_DIR=/etc/auth-service
ExecStart=/opt/auth-service/.venv/bin/uvicorn app.main:app --factory \
  --host 0.0.0.0 --port 8443 --no-server-header \
  --ssl-certfile /etc/auth-service/tls/cert.pem \
  --ssl-keyfile /etc/auth-service/tls/key.pem
Restart=always
RestartSec=2

# Hardening: read-only system; only the clients/ dir (last-mint stamps) is writable.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/etc/auth-service/clients
CapabilityBoundingSet=
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
