# auth-service settings (prefix AUTH_SERVICE_). Everything has a default.
# Security material lives in files under CONFIG_DIR, not here:
#   policy.yaml, keys/<kid>.pem + keys/active, clients/<id>.sha256 + .json

AUTH_SERVICE_CONFIG_DIR=/etc/auth-service
# AUTH_SERVICE_POLICY_PATH=/etc/auth-service/policy.yaml
AUTH_SERVICE_LOG_LEVEL=INFO
AUTH_SERVICE_RATE_LIMIT_PER_MINUTE=30
