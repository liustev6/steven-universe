# pi-server's settings on the Pi (installed as ~/pi-server/.env by infra/deployment/pi-server.sh).
# Every setting and its default: app/core/config.py. No secrets here: the client secret is a file,
# /etc/pi-server/credentials/client_secret (auth-service's scripts/add-client.sh put it there).

# The voice turn (docs/specs/voice-path.md): the speakerphone, speech-service, agent-service.
PI_SERVER_VOICE=true
PI_SERVER_VOICE_NAME=ryan
PI_SERVER_SILENCE_MS=700
