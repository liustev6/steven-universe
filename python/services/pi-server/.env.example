# pi-server settings. Every variable is optional; these are the defaults.

PI_SERVER_LOG_LEVEL=INFO

# Listen on localhost only: hey-pi runs on the same Pi, and nothing else
# on the network should reach this service.
PI_SERVER_HOST=127.0.0.1
PI_SERVER_PORT=8765

# Where device settings (e.g. light/dark mode) are saved.
PI_SERVER_DATA_DIR=~/.local/share/pi-server

# Mock data until home-hub exists: fake weather, Home Assistant entities and
# assistant replies.
PI_SERVER_MOCK=true
PI_SERVER_MOCK_WEATHER_INTERVAL=5
PI_SERVER_MOCK_REPLY_WORD_DELAY=0.15

# /debug/* endpoints for pushing test messages to hey-pi with curl.
PI_SERVER_DEBUG_ENDPOINTS=true
