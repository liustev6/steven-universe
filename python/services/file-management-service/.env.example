# file-management settings (prefix FILES_). Everything has a default; in production these are set
# in compose.yaml. Secrets are NOT set here: they are files (FILES_STORAGE_*_FILE), and setting
# FILES_STORAGE_ACCESS_KEY / FILES_STORAGE_SECRET_KEY is refused.

SERVICE_AUTH_ISSUER=https://auth.lan.liustev6.ca

FILES_STORAGE_ENDPOINT=http://192.168.50.123:9000
# FILES_STORAGE_ACCESS_KEY_FILE=/run/secrets/rustfs_access_key
# FILES_STORAGE_SECRET_KEY_FILE=/run/secrets/rustfs_secret_key
FILES_BUCKETS=["public", "private"]
FILES_MAX_UPLOAD_BYTES=1073741824
# FILES_MAX_UPLOAD_BYTES_PER_BUCKET={"public": 104857600}
# FILES_PART_SIZE_BYTES=8388608
FILES_LOG_LEVEL=INFO

# Local development only (no RustFS, no auth-service):
# ENV=local
# FILES_STORAGE=memory
# SERVICE_AUTH_DEV_PRINCIPAL={"service":"dev","scopes":["*"],"authorization_details":[{"type":"file_access","actions":["read","write","delete","list"],"locations":["public/","private/"]}]}
