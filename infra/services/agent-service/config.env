# agent-service's settings (non-secret). Installed as /etc/agent-service/config.env by every deploy.
# Defaults and meanings: python/services/agent-service/app/config.py (prefix AGENT_).

# Its own identity at auth-service (the secret is host-only, from add-client.sh)
SERVICE_AUTH_ISSUER=https://auth.lan.liustev6.ca
SERVICE_AUTH_CLIENT_ID=agent-service
SERVICE_AUTH_CLIENT_SECRET_FILE=/run/secrets/client_secret

# PostgreSQL (the `postgres` service in its compose project; the password from OpenBao)
AGENT_DB_HOST=postgres
AGENT_DB_PASSWORD_FILE=/run/secrets/postgres_password

# Sandboxes, the model, the login's durable copy
AGENT_RUNNER_URL=https://sandbox-runner.lan.liustev6.ca
AGENT_MODEL_UPSTREAM=https://chatgpt.com/backend-api/codex
AGENT_BAO_ADDR=https://bao.lan.liustev6.ca:8200

# Timers (C6)
AGENT_IDLE_SECONDS=300
AGENT_READY_TIMEOUT_SECONDS=60

AGENT_LOG_LEVEL=INFO
