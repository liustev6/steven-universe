# api-service: settings for this environment, installed as /etc/api-service/config.env by every
# deploy. Secrets never go here. Spec: docs/specs/api-service.md (D12 in deployer.md).

# CF-Connecting-IP is trusted only on requests from cloudflared (CT 100).
API_TRUSTED_PROXIES=["192.168.50.53"]

# /deploy/v1/deployments -> the deployer (CT 105), LAN only.
API_DEPLOYER_URL=https://deploy.lan.liustev6.ca

# Its own identity: auth-service client api-service (its secret is host-only, mounted at /run/secrets).
SERVICE_AUTH_ISSUER=https://auth.lan.liustev6.ca
SERVICE_AUTH_CLIENT_ID=api-service
SERVICE_AUTH_CLIENT_SECRET_FILE=/run/secrets/client_secret

# /v1/status: the lab's public status page (agent-service tracker "S"). health = a service's own
# /health; openbao = OpenBao's health (sealed or not); status = a service's /v1/status, read with
# api-service's token (status:read). Add every new service here (the S rule).
API_STATUS_TARGETS=[{"name":"auth-service","url":"https://auth.lan.liustev6.ca/health","kind":"health"},{"name":"file-management","url":"https://files.lan.liustev6.ca/health","kind":"health"},{"name":"deployer","url":"https://deploy.lan.liustev6.ca/health","kind":"health"},{"name":"openbao","url":"https://bao.lan.liustev6.ca:8200/v1/sys/health?sealedcode=200&uninitcode=200&standbycode=200","kind":"openbao"},{"name":"sandbox-runner","url":"https://sandbox-runner.lan.liustev6.ca/v1/status","kind":"status","audience":"sandbox-runner"}]

API_LOG_LEVEL=INFO
