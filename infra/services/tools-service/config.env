# tools-service settings for this environment (non-secret; reviewed like code). Every deploy installs
# this file as /etc/tools-service/config.env, which compose.yaml loads (env_file).
SERVICE_AUTH_ISSUER=https://auth.lan.liustev6.ca
# MCP's identity (RFC 9728 metadata) and the Host headers it answers (DNS rebinding protection)
TOOLS_MCP_URL=https://tools.lan.liustev6.ca:8443/mcp
TOOLS_MCP_ALLOWED_HOSTS=["tools.lan.liustev6.ca:8443"]
TOOLS_LOG_LEVEL=INFO
