# deployer: settings for this environment, installed as /etc/deployer/config.env by every deploy.
# Secrets never go here. Spec: docs/specs/deployer.md (D12, "Token checks").

# Its auth-service identity (OpenBao logins): service_auth.TokenClient.from_env
SERVICE_AUTH_ISSUER=https://auth.lan.liustev6.ca
SERVICE_AUTH_CLIENT_ID=deployer
SERVICE_AUTH_CLIENT_SECRET_FILE=/run/secrets/client_secret

# Which GitHub tokens may deploy: liustev6/steven-universe (numeric ids: names can be renamed),
# only from main, only the reusable deploy workflow (.github/workflows/deploy.yml, called by
# build.yml), only in the "production" environment (main only, D17).
DEPLOYER_GITHUB_REPOSITORY_ID=1102380459
DEPLOYER_GITHUB_OWNER_ID=90568652
DEPLOYER_GITHUB_WORKFLOW_REF=liustev6/steven-universe/.github/workflows/deploy.yml@refs/heads/main
DEPLOYER_GITHUB_ENVIRONMENT=production

DEPLOYER_BAO_ADDR=https://bao.lan.liustev6.ca:8200
DEPLOYER_LOG_LEVEL=INFO
