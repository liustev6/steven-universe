# file-management settings for this environment (non-secret; reviewed like code). Every deploy
# installs this file as /etc/file-management/config.env, which compose.yaml loads (env_file).
# The RustFS key is NOT here: it is a secret, delivered to /etc/file-management/credentials/.
# FILES_BUCKETS must equal the file_access location_roots in ../auth-service/policy.yaml.
SERVICE_AUTH_ISSUER=https://auth.lan.liustev6.ca
FILES_STORAGE_ENDPOINT=http://192.168.50.123:9000
FILES_BUCKETS=["public", "private"]
FILES_MAX_UPLOAD_BYTES=1073741824
FILES_LOG_LEVEL=INFO
