# speech-service's settings (non-secret). Installed as /etc/speech-service/config.env by every deploy.
# Defaults and meanings: python/services/speech-service/app/config.py (prefix SPEECH_).

# Tokens are checked against auth-service's public keys (it has no identity of its own: it calls no one)
SERVICE_AUTH_ISSUER=https://auth.lan.liustev6.ca

# The models, from the pre-start hook (models.yaml), mounted read-only
SPEECH_TTS_MODEL=/models/Qwen3-TTS-12Hz-1.7B-CustomVoice
# The 1.7B takes a style instruction (spike 15: with this one, no runaway sentences, no babble)
SPEECH_TTS_INSTRUCT=Speak at a steady, natural pace, without long pauses. 用平稳自然的语速说话，不要拖长或停顿。
SPEECH_STT_MODEL=/models/Qwen3-ASR-0.6B

# Concurrency and releases (T13): 2 running + 1 waiting per kind
SPEECH_TTS_SLOTS=2
SPEECH_STT_SLOTS=2
SPEECH_WAITING=1

LOG_LEVEL=INFO

# A reply's first piece waits for its whole first sentence (T16 off, 2026-11-18): with one generation per
# reply (T19), a first clause like "好的，" gives the model only a frame or two of text, then it waits for the
# next sentence: a fragment of the first word, then a gap. Until text is fed as it arrives.
SPEECH_TTS_FIRST_CLAUSE=false
