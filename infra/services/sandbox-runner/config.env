# sandbox-runner settings for this environment (non-secret; reviewed like code). Every deploy
# installs this file as /etc/sandbox-runner/config.env, which compose.yaml loads (env_file).
# The sandbox templates (images, sizes) are in templates.yaml next to this file.
SERVICE_AUTH_ISSUER=https://auth.lan.liustev6.ca
RUNNER_TEMPLATES_FILE=/etc/sandbox-runner/templates.yaml
# What the pods' proxies forward to: agent-service's gateway. Until it exists (CP3), the dev gateway
# on this VM, on the egress network as agent-dev-dev-gateway-1.
RUNNER_GATEWAY_URL=http://agent-dev-dev-gateway-1:8080
RUNNER_MAX=6
RUNNER_MAX_PER_TEMPLATE=3
RUNNER_LOG_LEVEL=INFO
