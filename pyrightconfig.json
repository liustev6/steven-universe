// Imports for the editor (Pylance/pyright): each service resolves its own `app` package; speech-service's
// experiments resolve speech-service's (they import its engine, as experiments/python/speech-service/run.sh
// does on the playground). The first matching root wins.
{
  "executionEnvironments": [
    { "root": "experiments/python/speech-service", "extraPaths": ["python/services/speech-service", "python/libs/service-auth"] },
    { "root": "experiments/python/wake-word" },
    { "root": "python/services/agent-service", "extraPaths": ["python/libs/service-auth", "python/libs/agent-runtime"] },
    { "root": "python/services/api-service", "extraPaths": ["python/libs/service-auth"] },
    { "root": "python/services/auth-service", "extraPaths": ["python/libs/service-auth"] },
    { "root": "python/services/deployer", "extraPaths": ["python/libs/service-auth"] },
    { "root": "python/services/file-management-service", "extraPaths": ["python/libs/service-auth"] },
    { "root": "python/services/pi-server", "extraPaths": ["python/libs/service-auth"] },
    { "root": "python/services/sandbox-runner", "extraPaths": ["python/libs/service-auth"] },
    { "root": "python/services/speech-service", "extraPaths": ["python/libs/service-auth"] },
    { "root": "python/services/gpu-server", "extraPaths": ["python/libs/shared-schemas"] },
    { "root": "python/services/stevenai-service", "extraPaths": ["python/libs/shared-schemas"] },
    { "root": "python/services/web-gateway", "extraPaths": ["python/libs/shared-schemas"] },
    { "root": "python/libs/agent-runtime" },
    { "root": ".", "extraPaths": ["python/libs/shared-schemas"] }
  ]
}
